/*--------------------------------*- C++ -*----------------------------------*\
  biotConsolidationFoam example case: 1D Biot consolidation
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      w;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Vertical displacement [m], positive downward (z points down).

dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    drained
    {
        // Loaded top: the solver sets gradient = sigma0/Mc from
        // biotProperties, so the value here is overwritten.
        type            fixedGradient;
        gradient        uniform 0;
        value           uniform 0;
    }
    impermeable
    {
        // Fixed base
        type            fixedValue;
        value           uniform 0;
    }
    sides
    {
        type            empty;
    }
}

// ************************************************************************* //
