/*--------------------------------*- C++ -*----------------------------------*\
  biotConsolidationFoam example case: 1D Biot consolidation
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Pore pressure [Pa]. With undrainedInitialState yes, the solver sets the
// internal field to the undrained response p0 before the first step.

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    drained
    {
        type            fixedValue;
        value           uniform 0;
    }
    impermeable
    {
        type            zeroGradient;
    }
    sides
    {
        type            empty;
    }
}

// ************************************************************************* //
