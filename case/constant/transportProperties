/*--------------------------------*- C++ -*----------------------------------*\
  poroConsolidationFoam example case: Terzaghi 1D consolidation
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Coefficient of consolidation cv = k / (mv * gammaW)  [m^2/s].
// Chosen so Tv = cv*t/H^2 = 0.01*t lands on round numbers; not fitted
// to any particular soil or rock.

cv              cv [0 2 -1 0 0 0 0] 0.01;

// ************************************************************************* //
